# Modèle de configuration. Copier en `.env` (jamais committé) puis remplir.
# Générer tous les secrets d'un coup :
#   pseudo-gateway gen-keys          (binaire)
#   docker run --rm ghcr.io/bouna7/pseudo-gateway gen-keys
# ou individuellement : openssl rand -hex 32
#
# Une variable definie DEUX fois dans ce fichier : la PREMIERE valeur gagne
# (les suivantes sont ignorees). Modifiez la ligne existante plutot que d'en
# ajouter une seconde a la fin.

# ─── Clés de chiffrement ────────────────────────────────────────────────────
# Mode versionné (recommandé) : une ou plusieurs versions de clé (32 octets hex).
#   PSEUDO_KEY_1=<hex64>
#   PSEUDO_KEY_2=<hex64>
# PSEUDO_CURRENT_KEY_ID : version utilisée pour CHIFFRER (défaut = la plus grande).
# Les autres versions restent chargées pour DÉCHIFFRER les anciens blobs.
# Rotation = ajouter PSEUDO_KEY_<n+1>, passer PSEUDO_CURRENT_KEY_ID=<n+1>, redémarrer.
PSEUDO_KEY_1=
PSEUDO_CURRENT_KEY_ID=
# Clé HMAC STABLE de déduplication (NE PAS changer après coup, sinon dédup cassée).
# Si absente : dérivée de PSEUDO_KEY_<plus petit id>.
PSEUDO_INDEX_KEY=
# Repli clé unique si aucune PSEUDO_KEY_* n'est définie. Si tout est vide, une clé
# de DEV éphémère est générée : les jetons deviennent illisibles au redémarrage.
MASTER_KEY=

# ─── Coffre ─────────────────────────────────────────────────────────────────
#   memory (défaut) — en mémoire, perdu au redémarrage (dev/tests)
#   redis          — persistant et partagé (recommandé pour la prod)
VAULT_STORE=memory
# URL Redis (utilisée si VAULT_STORE=redis).
REDIS_URL=redis://127.0.0.1:6379

# ─── Détection des noms (Presidio, optionnel) ───────────────────────────────
# Sans Presidio : repli regex (email, téléphone, IBAN, carte) + custom_terms.
PRESIDIO_URL=http://127.0.0.1:5002
PRESIDIO_LANG=en
# Timeout (ms) de l'appel NER (best effort).
PRESIDIO_TIMEOUT_MS=4000

# ─── Authentification ───────────────────────────────────────────────────────
# Clé interne (ex. files_service) : en-tête « X-Api-Key: <valeur> » ou
# « Authorization: Bearer <valeur> ». Choisit librement son tenant_id.
GATEWAY_API_KEY=
# Clé d'administration : active l'API PUBLIQUE (comptes, clés par utilisateur,
# quotas) et les routes /admin/* (en-tête « X-Admin-Key »).
ADMIN_API_KEY=
# Sans AUCUNE de ces deux clés, le service REFUSE de démarrer : /depseudonymize
# restitue des données réelles, une instance ouverte est une fuite et non un
# mode dégradé. Pour un usage local sans protection, l'assumer explicitement :
ALLOW_INSECURE=false

# ─── API publique ───────────────────────────────────────────────────────────
# Inscription libre sur POST /v1/signup (nécessite ADMIN_API_KEY).
PUBLIC_SIGNUP=false
SIGNUP_PER_IP_PER_HOUR=5
# Limites des nouveaux comptes (0 = illimité ; modifiables par compte via /admin).
DEFAULT_PLAN=free
DEFAULT_RATE_PER_MIN=60
DEFAULT_MONTHLY_QUOTA=10000
# Derrière un reverse proxy (Traefik, nginx) : lire l'IP client dans X-Forwarded-For.
TRUST_PROXY=false

# ─── HTTP ───────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0
PORT=8080
# Origines autorisées à appeler l'API depuis un navigateur (virgules), ou *.
# Vide = pas d'en-têtes CORS (appels serveur à serveur uniquement).
CORS_ALLOWED_ORIGINS=
# Documentation interactive sur /docs et spec sur /openapi.json.
ENABLE_DOCS=false
# URL publique annoncée dans la spec OpenAPI (ex. https://votre-domaine.exemple).
PUBLIC_BASE_URL=
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECS=30
RUST_LOG=info
